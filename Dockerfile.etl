FROM ghcr.io/astral-sh/uv:0.11.28 AS uv

FROM python:3.13-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /app

COPY --from=uv /uv /uvx /bin/

COPY pyproject.toml uv.lock README.md ./

RUN uv sync \
    --locked \
    --no-dev \
    --group etl \
    --no-install-project

COPY src ./src

RUN uv sync \
    --locked \
    --no-dev \
    --group etl \
    --no-editable

COPY warehouse ./warehouse
COPY data/samples/demo_transactions.csv ./data/samples/demo_transactions.csv

ENV PATH="/app/.venv/bin:${PATH}"

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app app \
    && chown -R app:app /app

USER app

CMD ["banking-intelligence-demo-job"]
